# ==============================================================================
# ewaBills Automation System - Environment Configuration
# ==============================================================================
#
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual credentials and settings
# 3. NEVER commit the .env file to version control
#
# Example: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# IMAP Configuration (for reading emails from Outlook)
# ------------------------------------------------------------------------------
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993
EMAIL_USER=your-email@outlook.com
EMAIL_PASSWORD=your-password-or-app-password

# Folder to read emails from (default: INBOX)
IMAP_FOLDER=INBOX

# Process only unread emails (True) or all emails (False)
PROCESS_UNREAD_ONLY=True

# ------------------------------------------------------------------------------
# SMTP Configuration (for sending emails via Outlook)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
USE_TLS=True

# Note: EMAIL_USER and EMAIL_PASSWORD are shared with IMAP settings above

# ------------------------------------------------------------------------------
# File Paths Configuration
# ------------------------------------------------------------------------------
# Path to the Excel/CSV file containing account mappings
MAPPING_FILE=./config/accounts_mapping.xlsx

# Working directories (will be created automatically if they don't exist)
DOWNLOADS_RAW_DIR=./downloads_raw
SINGLE_PAGES_DIR=./single_pages
MERGED_BY_GUY_DIR=./merged_by_guy
LOGS_DIR=./logs

# ------------------------------------------------------------------------------
# Processing Configuration
# ------------------------------------------------------------------------------
# Regex pattern to extract account numbers from PDF text
# Default pattern matches: "Account No: 123456" or "Account Number: 123456"
# Adjust this pattern to match your specific PDF format
ACCOUNT_REGEX=(?:Account\s*(?:No\.?|Number)?\s*:?\s*)(\d+)

# Batch sending configuration to avoid rate limits
BATCH_SIZE=30
BATCH_DELAY_SECONDS=60

# ------------------------------------------------------------------------------
# Email Template Configuration
# ------------------------------------------------------------------------------
# Subject line for sent emails
EMAIL_SUBJECT=Your Monthly Bills

# Email body template (use {guy_name} as placeholder for recipient name)
EMAIL_BODY_TEMPLATE=Dear {guy_name},

Please find attached your monthly bills.

This is an automated message. Please do not reply to this email.

Best regards,
Billing Department

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# SECURITY NOTES:
# ==============================================================================
#
# For Microsoft 365/Outlook accounts:
# - Consider using App Passwords instead of your main password
# - Enable 2FA on your account and create an app-specific password
# - Go to: https://account.microsoft.com/security
# - Click "Advanced security options" → "App passwords"
#
# Alternative: Use OAuth2 authentication (requires code modifications)
# ==============================================================================
