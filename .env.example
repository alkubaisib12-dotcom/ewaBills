# ==============================================================================
# ewaBills Automation System - Environment Configuration
# ==============================================================================
#
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual credentials and settings
# 3. NEVER commit the .env file to version control
#
# Example: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# IMAP Configuration (for reading emails)
# ------------------------------------------------------------------------------
# For Outlook/Office 365:
# IMAP_SERVER=outlook.office365.com
# IMAP_PORT=993
#
# For Gmail:
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
#
# For internal mail server:
# IMAP_SERVER=10.27.16.4
# IMAP_PORT=993

IMAP_SERVER=outlook.office365.com
IMAP_PORT=993
EMAIL_USER=your-email@outlook.com
EMAIL_PASSWORD=your-password-or-app-password

# Folder to read emails from (default: INBOX)
# Gmail folders: INBOX, [Gmail]/Sent Mail, [Gmail]/Drafts, [Gmail]/Spam
IMAP_FOLDER=INBOX

# Process only unread emails (True) or all emails (False)
PROCESS_UNREAD_ONLY=True

# ------------------------------------------------------------------------------
# SMTP Configuration (for sending emails)
# ------------------------------------------------------------------------------
# For Outlook/Office 365:
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
#
# For Gmail:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
#
# For internal mail server:
# SMTP_SERVER=10.27.16.4
# SMTP_PORT=587

SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
USE_TLS=True

# Note: EMAIL_USER and EMAIL_PASSWORD are shared with IMAP settings above

# ------------------------------------------------------------------------------
# File Paths Configuration
# ------------------------------------------------------------------------------
# Path to the Excel/CSV file containing account mappings
MAPPING_FILE=./config/accounts_mapping.xlsx

# Working directories (will be created automatically if they don't exist)
DOWNLOADS_RAW_DIR=./downloads_raw
SINGLE_PAGES_DIR=./single_pages
MERGED_BY_GUY_DIR=./merged_by_guy
LOGS_DIR=./logs

# ------------------------------------------------------------------------------
# Processing Configuration
# ------------------------------------------------------------------------------
# Regex pattern to extract account numbers from PDF text
# Matches 10-digit numbers starting with 1
# Example: 1069683595, 1069711941
#
# Pattern: 1\d{9}
# - Starts with 1
# - Followed by exactly 9 more digits (total 10 digits)
#
ACCOUNT_REGEX=1\d{9}

# Batch sending configuration to avoid rate limits
BATCH_SIZE=30
BATCH_DELAY_SECONDS=60

# ------------------------------------------------------------------------------
# Email Template Configuration
# ------------------------------------------------------------------------------
# Subject line for sent emails
EMAIL_SUBJECT=Your Monthly Bills

# Email body template - use {guy_name} as placeholder
# Note: Keep as single line or use \n for line breaks
EMAIL_BODY_TEMPLATE=Dear {guy_name},\n\nPlease find attached your monthly bills.\n\nThis is an automated message. Please do not reply to this email.\n\nBest regards,\nBilling Department

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# SECURITY NOTES:
# ==============================================================================
#
# For Gmail accounts:
# 1. Enable 2-Step Verification:
#    - Go to: https://myaccount.google.com/security
#    - Turn on 2-Step Verification
# 2. Generate App Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and "Other (Custom name)"
#    - Copy the 16-character password (remove spaces)
#    - Use this as EMAIL_PASSWORD
#
# For Microsoft 365/Outlook accounts:
# - Consider using App Passwords instead of your main password
# - Enable 2FA on your account and create an app-specific password
# - Go to: https://account.microsoft.com/security
# - Click "Advanced security options" → "App passwords"
#
# For internal mail servers:
# - Use your regular email password
# - Verify IMAP/SMTP ports with your IT department
#
# Alternative: Use OAuth2 authentication (requires code modifications)
# ==============================================================================
